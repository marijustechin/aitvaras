# Aitvaras workspace configuration — EXAMPLE ONLY.
# Copy this file to `.env` and adjust for your machine.
# Never put real credentials in this repository.

# --- Environment ---
# `pnpm seed:dev` (weak localdev/localdev account) only runs when NODE_ENV is
# "development" AND DATABASE_URL points at a local database.
NODE_ENV=development

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=aitvaras
POSTGRES_PASSWORD=aitvaras
POSTGRES_DB=aitvaras
POSTGRES_PORT=5432

# --- Aitvaras database (Prisma) ---
# Must match the POSTGRES_* values above for local development.
DATABASE_URL=postgresql://aitvaras:aitvaras@127.0.0.1:5432/aitvaras?schema=public

# --- Test database (integration tests) ---
# Integration tests MUST use this dedicated database and never the development
# database. Create it with `pnpm db:test:create` (or the docker init script on a
# fresh volume). Missing/invalid -> tests fail rather than fall back to dev.
TEST_DATABASE_URL=postgresql://aitvaras:aitvaras@127.0.0.1:5432/aitvaras_test?schema=public

# --- API (apps/api) ---
# Default local API port. Overridable.
API_PORT=3010

# --- Authentication ---
# JWT signing secret. REQUIRED. Must be at least 32 characters.
# Generate a strong random value, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Access token lifetime in seconds (short-lived; no refresh tokens yet).
JWT_ACCESS_TTL=3600

# Login brute-force protection (process-local; per-instance).
# Temporary lockout after LOGIN_MAX_ATTEMPTS failures within LOGIN_WINDOW_SECONDS,
# released after LOGIN_LOCKOUT_SECONDS.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# Comma-separated list of allowed web origins for CORS.
WEB_ORIGIN=http://localhost:3011,http://127.0.0.1:3011

# --- Initial admin bootstrap (OPTIONAL; used only by `pnpm bootstrap:admin`) ---
# Not required for normal development. The normal local login is
# `localdev` / `localdev`, created by `pnpm seed:dev` (see docs/development.md).
# No defaults are built in; the secure bootstrap fails without these. Real names
# are required. Never commit real credentials.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_FIRST_NAME=replace-with-first-name
BOOTSTRAP_ADMIN_LAST_NAME=replace-with-last-name
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Web (apps/web) ---
# Default local web port is 3011 (set in apps/web's dev script).
# The web app must not assume the API is on the same port.
NEXT_PUBLIC_API_URL=http://localhost:3010
