{
  "name": "@aitvaras/api",
  "version": "0.0.0",
  "private": true,
  "description": "Aitvaras API (NestJS on the Fastify adapter).",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "seed:dev": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "@aitvaras/contracts": "workspace:*",
    "@aitvaras/database": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-fastify": "12.0.3",
    "@node-rs/argon2": "2.2.1",
    "fastify": "5.12.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aitvaras/config": "workspace:*",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/node": "24.13.5",
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "vitest": "5.0.1"
  }
}
