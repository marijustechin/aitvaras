// Aitvaras owns its own PostgreSQL schema. Only confirmed, current requirements
// are modelled here: identity/access, business partners, resources and packing
// forms (reference data), warehouses and locations, the goods receipt
// (Pajamavimas), and physical receiving (incoming deliveries / Gavimai with
// homogeneous batches and handling units).
//
// Deliberately NOT present: stock balances, warehouse movements, purchasing,
// production, orders, dispatch, sales, tenancy or Sandėlys integration. Those
// concepts are unconfirmed discovery material, not approved scope. See
// ../../docs/scope.md.

generator client {
  // Prisma 7 Rust-free client. Outputs plain TypeScript that is compiled with
  // the package. `cjs` + bare import extensions keep it compatible with the
  // NestJS CommonJS build.
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

// Connection URL lives in prisma.config.ts (Prisma 7); the datasource block
// only declares the provider.
datasource db {
  provider = "postgresql"
}

// Canonical, stable role identifiers. The database enum is the persistence
// representation; `@aitvaras/contracts` (ROLE_KEYS) is the shared runtime
// representation. They must stay in sync.
enum RoleKey {
  ADMIN
  WAREHOUSE_WORKER
  ACCOUNTING
  PRODUCTION_MANAGER
}

// A user of Aitvaras. Authentication uses the unique `username`; `firstName`
// and `lastName` are the person's real display identity. Roles are related
// explicitly (many-to-many via UserRole).
model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(64)
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  // Bumped whenever the password is changed by an administrator. Access tokens
  // embed this value (`ver`); the auth guard rejects tokens whose version is
  // stale, which invalidates the user's existing sessions immediately.
  tokenVersion Int      @default(0) @map("token_version")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles UserRole[]

  batches                Batch[]
  bags                   Bag[]
  voidedBags             Bag[]                @relation("BagVoidedBy")
  bagCorrections         BagCorrection[]      @relation("BagCorrectionCreatedBy")
  incomingDeliveries     IncomingDelivery[]
  receivingDiscrepancies ReceivingDiscrepancy[]
  discrepancySettlements DiscrepancySettlement[] @relation("DiscrepancySettlementCreatedBy")

  @@map("users")
}

// A role. Identified by a stable semantic key (RoleKey) rather than a numeric
// id, so meaning is explicit in data and code.
model Role {
  id        String   @id @default(uuid()) @db.Uuid
  key       RoleKey  @unique
  name      String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

// Explicit join model for user <-> role assignment.
model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Partner business roles. These are a business-domain concept, deliberately
// separate from system access roles (RoleKey). A partner may hold several.
enum PartnerRoleKey {
  SUPPLIER
  BUYER
}

// A business counterparty (partneris). Suppliers and buyers are NOT separate
// entities: one partner may be a supplier, a buyer, or both. Optional fields
// are nullable (unset), never empty strings. `companyCode`/`vatCode` are
// intentionally not unique — foreign/unknown values are expected.
model BusinessPartner {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(255)
  companyCode   String?  @map("company_code") @db.VarChar(64)
  vatCode       String?  @map("vat_code") @db.VarChar(64)
  address       String?  @db.VarChar(500)
  country       String?  @db.VarChar(100)
  contactPerson String?  @map("contact_person") @db.VarChar(200)
  phone         String?  @db.VarChar(64)
  email         String?  @db.VarChar(254)
  notes         String?  @db.VarChar(2000)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  roles PartnerRole[]

  receipts               GoodsReceipt[]
  incomingDeliveries     IncomingDelivery[]
  receivingDiscrepancies ReceivingDiscrepancy[]

  @@index([name])
  @@map("business_partners")
}

// Normalised, multi-valued partner role assignment. Composite primary key gives
// deterministic, duplicate-free representation and the FK is indexed.
model PartnerRole {
  partnerId String         @map("partner_id") @db.Uuid
  role      PartnerRoleKey
  createdAt DateTime       @default(now()) @map("created_at")

  partner BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@id([partnerId, role])
  @@map("partner_roles")
}

// A managed resource classification (Išteklių kategorija). A resource has
// exactly one. Categories are administrator-managed master data, not a closed
// enum: the three historical values (Žaliava, Pusgaminis, Gaminys) are seeded
// once by migration and are NOT the complete allowed set. Deactivated, never
// hard-deleted; inactive categories stay valid for existing resources but cannot
// be chosen for new ones.
model ResourceCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  resources Resource[]

  @@map("resource_categories")
}

// A business item/material/product handled by Aitvaras. Only confirmed fields
// are modelled; price, VAT, barcode, quantity, stock, location, supplier,
// dimensions, weight, unit and reorder level are deliberately absent until
// confirmed. `name` is intentionally not unique: two resources may share a
// descriptive name.
model Resource {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(255)
  categoryId String   @map("category_id") @db.Uuid
  notes      String?  @db.VarChar(2000)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category          ResourceCategory  @relation(fields: [categoryId], references: [id])
  goodsReceiptLines GoodsReceiptLine[]
  batches           Batch[]

  @@index([name])
  @@index([categoryId])
  @@map("resources")
}

// Measurement units for a goods-receipt line. A small, fixed set for now (no
// user-managed administration module; more units only when confirmed).
enum MeasurementUnitKey {
  KG
  UNIT
}

// A warehouse (Sandėlis). Deactivated, never normally deleted. Only confirmed
// fields are modelled (no address/code/manager/capacity yet).
model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  locations    WarehouseLocation[]
  receiptLines GoodsReceiptLine[]
  batches      Batch[]

  @@index([name])
  @@map("warehouses")
}

// A physical location (Sandėlio vieta) inside exactly one warehouse. Names are
// unique per warehouse, not globally (two warehouses may both have "Stelažas 1").
// Uniqueness is case-sensitive per the database default; we do not normalise
// case (no complex normalisation subsystem).
model WarehouseLocation {
  id          String   @id @default(uuid()) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  name        String   @db.VarChar(255)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id])
  receiptLines GoodsReceiptLine[]
  bags         Bag[]

  @@unique([warehouseId, name])
  @@index([warehouseId])
  @@map("warehouse_locations")
}

// Pajamavimas — a record of the physical receipt of resources from a supplier
// partner. It is NOT an accounting purchase, supplier invoice, payment, stock
// ledger or warehouse balance, and it deliberately has no status/lifecycle yet.
// Saves do not create or modify warehouse stock. `documentDate`/`documentNumber`
// are the formal business-document metadata (supplier document date/number),
// distinct from `createdAt` (system record time); they may be supplied during
// batch reconciliation and are otherwise empty.
model GoodsReceipt {
  id             String    @id @default(uuid()) @db.Uuid
  partnerId      String    @map("partner_id") @db.Uuid
  documentDate   DateTime? @map("document_date")
  documentNumber String?   @map("document_number") @db.VarChar(64)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  partner BusinessPartner   @relation(fields: [partnerId], references: [id])
  lines   GoodsReceiptLine[]

  @@index([partnerId])
  @@index([createdAt])
  @@map("goods_receipts")
}

// A receipt line. `quantity` and `unitPrice` are decimals (never floating
// point). `unitPrice` is the price per selected measurement unit, in EUR for
// this first Lithuanian operational flow (no currency management). Placement:
// `warehouseId` is required; `warehouseLocationId` is optional (a location, when
// supplied, must belong to that warehouse).
model GoodsReceiptLine {
  id                  String             @id @default(uuid()) @db.Uuid
  goodsReceiptId      String             @map("goods_receipt_id") @db.Uuid
  resourceId          String             @map("resource_id") @db.Uuid
  quantity            Decimal            @db.Decimal(14, 3)
  unit                MeasurementUnitKey
  unitPrice           Decimal            @map("unit_price") @db.Decimal(14, 4)
  warehouseId         String             @map("warehouse_id") @db.Uuid
  warehouseLocationId String?            @map("warehouse_location_id") @db.Uuid

  receipt           GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  resource          Resource           @relation(fields: [resourceId], references: [id])
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  warehouseLocation WarehouseLocation? @relation(fields: [warehouseLocationId], references: [id])
  batch             Batch?

  @@index([goodsReceiptId])
  @@index([resourceId])
  @@index([warehouseId])
  @@index([warehouseLocationId])
  @@map("goods_receipt_lines")
}

// Packaging / tare master data (Tara) — the canonical physical-packaging master
// data. Each physical handling unit references one
// packaging type; its `tareWeightKg` (Decimal 14,3 — never floating point) is
// subtracted from the entered gross weight to derive the net weight. Managed by
// administrators (list/create/edit/activate), deactivated rather than deleted so
// historical packages keep valid references.
model PackagingType {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @unique @db.VarChar(255)
  tareWeightKg Decimal  @map("tare_weight_kg") @db.Decimal(14, 3)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  bags Bag[]

  @@map("packaging_types")
}

// Status of a receiving batch. A documentary/physical mismatch does NOT keep a
// batch unconfirmed — the batch is `CONFIRMED` and the mismatch is recorded as a
// separate `ReceivingDiscrepancy`.
enum BatchStatus {
  PENDING
  CONFIRMED
}

// Lifecycle of a receiving discrepancy. A discrepancy starts `OPEN`; settlement
// entries move it to `PARTIALLY_SETTLED`, and `SETTLED` once the original
// magnitude is fully covered.
enum ReceivingDiscrepancyStatus {
  OPEN
  PARTIALLY_SETTLED
  SETTLED
}

// How a discrepancy settlement covers (part of) the original magnitude. `WEIGHT`
// records additional physical weight from a later delivery; `MONEY` records a
// money/credit agreement. No money↔weight conversion is ever performed.
enum DiscrepancySettlementType {
  WEIGHT
  MONEY
}

// One physical incoming delivery / arrival (Gavimas): the physical goods of ONE
// supplier on ONE arrival date, registered by a warehouse worker. A delivery is
// the user-facing receiving unit and the container above batches: it may contain
// several resources, and different batches may go to different warehouses. The
// `code` is the compact human-facing identifier `GYYMM-NN` (month sequence); it
// encodes no business data. Only supplier + arrival date live here (no transport
// vehicle is modelled).
model IncomingDelivery {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(16)
  supplierId  String   @map("supplier_id") @db.Uuid
  arrivalDate DateTime @map("arrival_date")
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplier  BusinessPartner @relation(fields: [supplierId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  batches   Batch[]

  @@index([supplierId])
  @@index([createdAt])
  @@map("incoming_deliveries")
}

// A receiving batch/lot (Partija): the INTERNAL grouping of ONE resource into ONE
// warehouse within a single IncomingDelivery (Gavimas). A delivery may contain
// several batches, including the same resource into different warehouses; a batch
// is exactly one (delivery, resource, warehouse) combination. It stays `PENDING`
// until a responsible person formally confirms it. `code` is an internal
// system-generated identifier (secondary to the human-facing delivery code). It
// is reconciled with the formal GoodsReceipt WITHOUT duplicating
// stock/quantities. Physical receiving is weight-based; the optional
// `documentPieces` is documentary business information only (never a physical
// unit, never driving handling-unit totals).
model Batch {
  id         String      @id @default(uuid()) @db.Uuid
  // Compact, delivery-local human-facing code (`P01`..`P99`); uniqueness is
  // scoped to the delivery (see `@@unique([deliveryId, code])`). The UUID `id` is
  // the true technical identity.
  code       String      @db.VarChar(32)
  deliveryId String      @map("delivery_id") @db.Uuid
  resourceId String      @map("resource_id") @db.Uuid
  warehouseId String     @map("warehouse_id") @db.Uuid
  status     BatchStatus @default(PENDING)
  // Reconciliation with the formal GoodsReceipt. The linked line is the formal
  // document anchor; `documentWeight`/`acquisitionAmount` are the accepted
  // documentary values entered at reconciliation (distinct from the measured
  // bag weight), `documentPieces` is an optional documentary piece count, and
  // `confirmedAt` is set only on a clean CONFIRMED result.
  receiptLineId     String?   @unique @map("receipt_line_id") @db.Uuid
  documentWeight    Decimal?  @map("document_weight") @db.Decimal(14, 3)
  documentPieces    Int?      @map("document_pieces")
  acquisitionAmount Decimal?  @map("acquisition_amount") @db.Decimal(14, 2)
  confirmedAt       DateTime? @map("confirmed_at")
  createdById       String    @map("created_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  delivery    IncomingDelivery @relation(fields: [deliveryId], references: [id])
  resource    Resource         @relation(fields: [resourceId], references: [id])
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  receiptLine GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  bags        Bag[]
  discrepancy ReceivingDiscrepancy?
  discrepancySettlements DiscrepancySettlement[] @relation("DiscrepancySettlementSourceBatch")

  @@unique([deliveryId, code])
  @@unique([deliveryId, resourceId, warehouseId])
  @@index([status])
  @@index([resourceId])
  @@index([warehouseId])
  @@map("batches")
}

// Lifecycle of a physical handling unit. A unit is never hard-deleted: an
// erroneous unit is `VOIDED` (barcode and history preserved) and excluded from
// the batch's active measured total.
enum BagStatus {
  ACTIVE
  VOIDED
}

// A small, focused correction trail for handling units (no generic audit
// framework). `PACKAGING`/`GROSS_WEIGHT`/`LOCATION` record previous → new values;
// `VOID` records the reason a unit was voided.
enum BagCorrectionKind {
  PACKAGING
  GROSS_WEIGHT
  LOCATION
  VOID
}

// A physical package / handling unit (e.g. bag, box, pallet; one row of a
// batch). `barcode` uniquely identifies ONE physical package and encodes NO
// business data (no supplier, resource, date, batch or cost) — the relationships
// provide that. Physical receiving is by actual WEIGHT: the worker enters
// `grossWeight` and selects a `packagingType`; the server snapshots the current
// tare into `tareWeightKg` and derives `netWeight = grossWeight - tareWeightKg`
// (never client-supplied, never floating point). The snapshot keeps historical
// `grossWeight - tareWeightKg = netWeight` true even if the PackagingType master
// record is later edited. Every package must be placed in a `warehouseLocation`
// belonging to the batch's warehouse (required; `ON DELETE RESTRICT`).
model Bag {
  id                  String    @id @default(uuid()) @db.Uuid
  barcode             String    @unique @db.VarChar(32)
  batchId             String    @map("batch_id") @db.Uuid
  packagingTypeId     String    @map("packaging_type_id") @db.Uuid
  grossWeight         Decimal   @map("gross_weight") @db.Decimal(14, 3)
  // Immutable/current snapshot of the tare actually used to compute `netWeight`
  // (copied from the PackagingType at registration/registration-correction time).
  // Historical net calculations never read the live PackagingType master value.
  tareWeightKg        Decimal   @map("tare_weight_kg") @db.Decimal(14, 3)
  netWeight           Decimal   @map("net_weight") @db.Decimal(14, 3)
  warehouseLocationId String    @map("warehouse_location_id") @db.Uuid
  status              BagStatus @default(ACTIVE)
  voidedById          String?   @map("voided_by_id") @db.Uuid
  voidedAt            DateTime? @map("voided_at")
  voidReason          String?   @map("void_reason") @db.VarChar(500)
  createdById         String    @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  batch             Batch             @relation(fields: [batchId], references: [id])
  packagingType     PackagingType     @relation(fields: [packagingTypeId], references: [id])
  warehouseLocation WarehouseLocation @relation(fields: [warehouseLocationId], references: [id])
  createdBy         User              @relation(fields: [createdById], references: [id])
  voidedBy          User?             @relation("BagVoidedBy", fields: [voidedById], references: [id])
  corrections       BagCorrection[]

  @@index([batchId])
  @@index([packagingTypeId])
  @@index([warehouseLocationId])
  @@index([status])
  @@map("bags")
}

// An auditable handling-unit correction (weight change, location change or
// void). Values are stored as strings for a readable trail; `createdBy`/`createdAt`
// record who/when.
model BagCorrection {
  id            String            @id @default(uuid()) @db.Uuid
  bagId         String            @map("bag_id") @db.Uuid
  kind          BagCorrectionKind
  previousValue String?           @map("previous_value") @db.VarChar(255)
  newValue      String?           @map("new_value") @db.VarChar(255)
  reason        String?           @db.VarChar(500)
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  bag       Bag  @relation(fields: [bagId], references: [id])
  createdBy User @relation("BagCorrectionCreatedBy", fields: [createdById], references: [id])

  @@index([bagId])
  @@map("bag_corrections")
}

// A receiving discrepancy recorded when a batch is CONFIRMED with a documentary
// vs measured (net) mismatch. It is tied one-to-one to the confirmed batch
// (`batchId` unique) so a confirmation retry cannot create duplicates. Signed
// `differenceWeight = measuredWeight − documentWeight` (positive = physically
// received more than documented). The physical stock remains the measured net
// weight; the discrepancy is settled separately later (by weight or money).
model ReceivingDiscrepancy {
  id               String                    @id @default(uuid()) @db.Uuid
  batchId          String                    @unique @map("batch_id") @db.Uuid
  supplierId       String                    @map("supplier_id") @db.Uuid
  measuredWeight   Decimal                   @map("measured_weight") @db.Decimal(14, 3)
  documentWeight   Decimal                   @map("document_weight") @db.Decimal(14, 3)
  differenceWeight Decimal                   @map("difference_weight") @db.Decimal(14, 3)
  status           ReceivingDiscrepancyStatus @default(OPEN)
  createdById      String                    @map("created_by_id") @db.Uuid
  createdAt        DateTime                  @default(now()) @map("created_at")
  settledAt        DateTime?                 @map("settled_at")

  batch     Batch           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  supplier  BusinessPartner @relation(fields: [supplierId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])

  settlements DiscrepancySettlement[]

  @@index([status])
  @@index([supplierId])
  @@map("receiving_discrepancies")
}

// An append-only settlement entry against a receiving discrepancy. `coveredWeightKg`
// is always positive and expressed in kg — it is the amount of the original
// discrepancy magnitude (|measured − document|) this entry resolves; the sign of
// the discrepancy is never changed and never re-derived. `WEIGHT` may link the
// later confirmed batch that physically covers it (the batch already owns that
// stock; the settlement does not create inventory). `MONEY` records a money/credit
// amount without any money↔weight conversion. Entries are never edited or deleted;
// a future correction would be a separate audited workflow.
model DiscrepancySettlement {
  id              String                   @id @default(uuid()) @db.Uuid
  discrepancyId   String                   @map("discrepancy_id") @db.Uuid
  type            DiscrepancySettlementType
  coveredWeightKg Decimal                  @map("covered_weight_kg") @db.Decimal(14, 3)
  moneyAmount     Decimal?                 @map("money_amount") @db.Decimal(14, 2)
  currency        String?                  @db.VarChar(8)
  sourceBatchId   String?                  @map("source_batch_id") @db.Uuid
  reference       String?                  @db.VarChar(255)
  note            String?                  @db.VarChar(2000)
  createdById     String                   @map("created_by_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")

  discrepancy ReceivingDiscrepancy @relation(fields: [discrepancyId], references: [id], onDelete: Restrict)
  sourceBatch Batch?               @relation("DiscrepancySettlementSourceBatch", fields: [sourceBatchId], references: [id], onDelete: Restrict)
  createdBy   User                 @relation("DiscrepancySettlementCreatedBy", fields: [createdById], references: [id])

  @@index([discrepancyId])
  @@index([sourceBatchId])
  @@map("discrepancy_settlements")
}
